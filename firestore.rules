rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regla para el estado del evento
    match /event_status/{document=**} {
      // CUALQUIERA puede LEER (para saber si hay examen)
      allow read: if true; 
      
      // SOLO el Backend (Service Account) puede ESCRIBIR
      // (Las Service Accounts se saltan estas reglas automáticamente)
      allow write: if false; 
    }
    
    // Si implementas CHAT entre usuarios
    match /chats/{chatId} {
      allow read, write: if request.auth != null; // Solo usuarios logueados
    }
  }
}
